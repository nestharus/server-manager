# Discord
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_STAGING_GUILD_ID=your-staging-guild-id

# Applicant Discord OAuth
DISCORD_APPLICANT_OAUTH_CLIENT_ID=your-discord-oauth-client-id
DISCORD_APPLICANT_OAUTH_CLIENT_SECRET=your-discord-oauth-client-secret
APPLICANT_OIDC_CLIENT_ID=humility-local-server-manager-applicant
APPLICANT_OIDC_CLIENT_SECRET=your-applicant-oidc-client-secret
AUTHENTIK_AUTHORIZE_URL=https://auth.local.humility.local/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://auth.local.humility.local/application/o/token/
AUTHENTIK_JWKS_URL=https://auth.local.humility.local/application/o/server-manager-applicant/jwks/
AUTHENTIK_ISSUER_URL=https://auth.local.humility.local/application/o/server-manager-applicant/
APPLICANT_DISCORD_REDIRECT_URI=https://web.local.humility.local/auth/discord/callback
APPLICANT_RECEIPT_SIGNING_KEY=your-applicant-receipt-signing-key
APPLICANT_RECEIPT_TTL_SECONDS=600

# Supabase
SUPABASE_DB_URL=postgresql://...
SUPABASE_SERVICE_KEY=your-service-key

# Railway
RAILWAY_TOKEN=your-railway-token

# OCR / LLM providers
GOOGLE_CLOUD_VISION_KEY=your-google-cloud-vision-key
GEMINI_API_KEY=your-gemini-api-key
Z_AI_API_KEY=your-z-ai-api-key
MINIMAX_API_KEY=your-minimax-api-key
