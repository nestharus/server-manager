FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY services/discord /app/services/discord

RUN pip install --upgrade pip \
    && pip install /app/services/discord

WORKDIR /app/services/discord

USER 10001:10001

CMD ["python", "-m", "app"]

