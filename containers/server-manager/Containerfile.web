FROM node:22.15.0-alpine AS build

WORKDIR /workspace

ARG FA_NPM_TOKEN
ARG WA_NPM_TOKEN
ENV FA_NPM_TOKEN=${FA_NPM_TOKEN}
ENV WA_NPM_TOKEN=${WA_NPM_TOKEN}

COPY services/web/package.json services/web/package-lock.json ./services/web/
COPY services/web/scripts ./services/web/scripts
WORKDIR /workspace/services/web
RUN node scripts/write-npmrc.mjs && npm ci --legacy-peer-deps && rm -f .npmrc

WORKDIR /workspace
COPY forms ./forms
COPY services/web ./services/web
WORKDIR /workspace/services/web
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY containers/server-manager/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/services/web/dist /usr/share/nginx/html

EXPOSE 8080
