{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humility.local/schemas/platform-channel.schema.json",
  "title": "Humility platform channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "exposure",
    "parent",
    "tenant",
    "allow_ephemeral_children",
    "enabled_platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/channelId"
    },
    "exposure": {
      "type": "string",
      "enum": ["prod", "stage", "dev"]
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/channelId"
        },
        {
          "type": "null"
        }
      ]
    },
    "tenant": {
      "anyOf": [
        {
          "$ref": "#/$defs/channelId"
        },
        {
          "type": "null"
        }
      ]
    },
    "allow_ephemeral_children": {
      "type": "boolean"
    },
    "enabled_platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["docker", "kubernetes"]
      },
      "uniqueItems": true
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "state": {
      "$ref": "#/$defs/state"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parent": {
            "const": null
          }
        },
        "required": ["parent"]
      },
      "then": {
        "required": ["platform", "cluster", "state"],
        "properties": {
          "platform": {
            "required": ["region", "network"]
          },
          "cluster": {
            "required": [
              "label",
              "kubernetes_version",
              "node_pools",
              "ha_controlplanes",
              "enable_firewall"
            ]
          },
          "state": {
            "required": ["bucket", "key", "region"]
          }
        }
      }
    }
  ],
  "$defs": {
    "channelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": {
          "$ref": "#/$defs/region"
        },
        "network": {
          "$ref": "#/$defs/network"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v4_subnet", "v4_subnet_mask"],
      "properties": {
        "v4_subnet": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "v4_subnet_mask": {
          "type": "integer",
          "minimum": 16,
          "maximum": 28
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kubernetes_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9]+$"
        },
        "node_pools": {
          "type": "array",
          "description": "INIT-008 platform-channel template supports one node pool; multi-pool support is deferred to a future channel template.",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/nodePool"
          }
        },
        "ha_controlplanes": {
          "type": "boolean"
        },
        "enable_firewall": {
          "type": "boolean"
        }
      }
    },
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "plan"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^channels/[a-z0-9-]+(/ephemeral/[a-z0-9-]+)?/terraform\\.tfstate$"
        },
        "region": {
          "$ref": "#/$defs/region"
        }
      }
    }
  }
}
