{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humility.local/schemas/platform-channel.schema.json",
  "title": "Humility platform channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "parent",
    "exposure",
    "tenant",
    "allow_ephemeral_children",
    "enabled_platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Schema version 1 accepts additive fields such as gitops; breaking field or semantic changes require schema_version 2."
    },
    "id": {
      "$ref": "#/$defs/channelId"
    },
    "parent": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "exposure": {
      "type": "string",
      "enum": ["prod", "stage", "dev"]
    },
    "tenant": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "allow_ephemeral_children": {
      "type": "boolean"
    },
    "enabled_platforms": {
      "$ref": "#/$defs/enabledPlatforms"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "gitops": {
      "$ref": "#/$defs/gitops"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parent": {
            "const": null
          }
        },
        "required": ["parent"]
      },
      "then": {
        "required": ["cluster", "state"]
      }
    },
    {
      "if": {
        "properties": {
          "cluster": {
            "properties": {
              "target": {
                "const": "k3d-local"
              }
            },
            "required": ["target"]
          }
        },
        "required": ["cluster"]
      },
      "then": {
        "required": ["gitops"]
      }
    }
  ],
  "$defs": {
    "channelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "enabledPlatforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["docker", "kubernetes"]
      },
      "uniqueItems": true
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "k3s_version", "target"],
      "properties": {
        "distribution": {
          "const": "k3s"
        },
        "k3s_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$"
        },
        "target": {
          "type": "string",
          "enum": ["k3d-local", "vultr-vms"]
        },
        "k3d": {
          "$ref": "#/$defs/k3d"
        },
        "vultr_vms": {
          "$ref": "#/$defs/vultrVms"
        }
      },
      "oneOf": [
        {
          "properties": {
            "target": {
              "const": "k3d-local"
            }
          },
          "required": ["k3d"],
          "not": {
            "required": ["vultr_vms"]
          }
        },
        {
          "properties": {
            "target": {
              "const": "vultr-vms"
            }
          },
          "required": ["vultr_vms"],
          "not": {
            "required": ["k3d"]
          }
        }
      ]
    },
    "k3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servers", "agents", "registry_name"],
      "properties": {
        "servers": {
          "type": "integer",
          "minimum": 1
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "registry_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vultrVms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "servers", "agents"],
      "properties": {
        "region": {
          "$ref": "#/$defs/region"
        },
        "allowed_ssh_cidrs": {
          "$ref": "#/$defs/cidrList"
        },
        "remote_kubeconfig_path": {
          "type": "string",
          "minLength": 1,
          "default": "/root/humility-k3s.yaml"
        },
        "firewall_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "default": null
        },
        "ssh_key_ids": {
          "$ref": "#/$defs/stringList"
        },
        "servers": {
          "$ref": "#/$defs/serverVmPool"
        },
        "agents": {
          "$ref": "#/$defs/agentVmPool"
        }
      }
    },
    "serverVmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "plan"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentVmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "plan"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "region"],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "key": {
          "type": "string",
          "pattern": "^channels/[a-z0-9-]+/terraform\\.tfstate$"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "default": "https://ewr1.vultrobjects.com"
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "git_url",
        "git_ref",
        "path",
        "kustomization_name",
        "kustomization_namespace",
        "sops_age_secret_name",
        "decryption_secret_namespace",
        "interval",
        "retry_interval",
        "prune",
        "wait"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["git"]
        },
        "git_url": {
          "type": "string",
          "pattern": "^(http|https|ssh)://[^\\s]+$"
        },
        "git_ref": {
          "type": "string",
          "pattern": "^(refs/(heads|tags)/[A-Za-z0-9._/-]+|[A-Za-z0-9._/-]+)$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\./gitops/channels/[a-z0-9-]+$"
        },
        "kustomization_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kustomization_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "sops_age_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "decryption_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "retry_interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "prune": {
          "type": "boolean"
        },
        "wait": {
          "type": "boolean"
        }
      }
    }
  }
}
