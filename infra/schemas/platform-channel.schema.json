{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humility.local/schemas/platform-channel.schema.json",
  "title": "Humility platform channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "parent",
    "exposure",
    "tenant",
    "allow_ephemeral_children",
    "enabled_platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Schema version 1 accepts additive fields such as gitops; breaking field or semantic changes require schema_version 2."
    },
    "id": {
      "$ref": "#/$defs/channelId"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "exposure": {
      "type": "string",
      "enum": [
        "prod",
        "stage",
        "dev"
      ]
    },
    "tenant": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "allow_ephemeral_children": {
      "type": "boolean"
    },
    "enabled_platforms": {
      "$ref": "#/$defs/enabledPlatforms"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "gitops": {
      "$ref": "#/$defs/gitops"
    },
    "infisical": {
      "$ref": "#/$defs/infisical"
    },
    "object_storage": {
      "$ref": "#/$defs/objectStorage"
    },
    "tls": {
      "$ref": "#/$defs/tls"
    },
    "dns": {
      "$ref": "#/$defs/dns"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parent": {
            "const": null
          }
        },
        "required": [
          "parent"
        ]
      },
      "then": {
        "required": [
          "cluster",
          "state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cluster": {
            "properties": {
              "target": {
                "const": "k3d-local"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        "required": [
          "cluster"
        ]
      },
      "then": {
        "required": [
          "gitops",
          "infisical",
          "object_storage",
          "tls",
          "dns"
        ],
        "properties": {
          "object_storage": {
            "required": [
              "provider",
              "endpoint",
              "region",
              "bucket",
              "credentials_secret_name",
              "credentials_secret_namespace",
              "infisical_project",
              "infisical_path"
            ],
            "properties": {
              "provider": {
                "const": "minio"
              },
              "endpoint": {
                "const": "http://minio.minio-system.svc.cluster.local:9000"
              },
              "region": {
                "const": "us-east-1"
              },
              "bucket": {
                "const": "humility-local-sample"
              },
              "credentials_secret_name": {
                "const": "minio-root"
              },
              "credentials_secret_namespace": {
                "const": "minio-system"
              },
              "infisical_project": {
                "const": "platform-storage"
              },
              "infisical_path": {
                "const": "/object-storage/local/"
              }
            }
          },
          "tls": {
            "required": [
              "provider",
              "local_cluster_issuer_name",
              "step_ca_namespace",
              "step_ca_service_name",
              "step_issuer_namespace",
              "sample_certificate_namespace",
              "sample_certificate_name",
              "local_domain"
            ],
            "properties": {
              "provider": {
                "const": "step-ca"
              },
              "local_cluster_issuer_name": {
                "const": "humility-local-step-ca"
              },
              "step_ca_namespace": {
                "const": "step-ca-system"
              },
              "step_ca_service_name": {
                "const": "step-ca"
              },
              "step_issuer_namespace": {
                "const": "step-issuer-system"
              },
              "sample_certificate_namespace": {
                "const": "cert-manager-test"
              },
              "sample_certificate_name": {
                "const": "humility-local-sample"
              },
              "local_domain": {
                "const": "humility.local"
              }
            }
          },
          "dns": {
            "required": [
              "provider",
              "local_domain",
              "cluster_domain",
              "coredns_configmap_namespace",
              "coredns_configmap_name",
              "sample_lookup_name"
            ],
            "properties": {
              "provider": {
                "const": "coredns"
              },
              "local_domain": {
                "const": "humility.local"
              },
              "cluster_domain": {
                "const": "cluster.local"
              },
              "coredns_configmap_namespace": {
                "const": "kube-system"
              },
              "coredns_configmap_name": {
                "const": "coredns"
              },
              "sample_lookup_name": {
                "const": "minio.minio-system.humility.local"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cluster": {
            "properties": {
              "target": {
                "const": "vultr-vms"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        "required": [
          "cluster"
        ]
      },
      "then": {
        "properties": {
          "object_storage": {
            "required": [
              "provider",
              "region",
              "bucket",
              "credentials_secret_name",
              "credentials_secret_namespace",
              "infisical_project",
              "infisical_path"
            ],
            "properties": {
              "provider": {
                "const": "vultr-object-storage"
              },
              "endpoint": {
                "pattern": "^https://[a-z]{3}1\\.vultrobjects\\.com$"
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "infisical_project": {
                "const": "platform-storage"
              },
              "infisical_path": {
                "pattern": "^/object-storage/[a-z0-9][a-z0-9-]*/$"
              }
            }
          },
          "tls": {
            "required": [
              "provider",
              "remote_cluster_issuer_name",
              "acme_server",
              "acme_email",
              "cloudflare_api_token_secret_name",
              "cloudflare_api_token_secret_namespace"
            ],
            "properties": {
              "provider": {
                "const": "acme"
              },
              "remote_cluster_issuer_name": {
                "const": "letsencrypt-staging"
              },
              "acme_server": {
                "const": "https://acme-staging-v02.api.letsencrypt.org/directory"
              },
              "acme_email": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              },
              "cloudflare_api_token_secret_name": {
                "const": "cloudflare-api-token"
              },
              "cloudflare_api_token_secret_namespace": {
                "const": "external-dns-system"
              }
            }
          },
          "dns": {
            "required": [
              "provider",
              "domain",
              "external_dns_owner_id",
              "cloudflare_api_token_secret_name",
              "cloudflare_api_token_secret_namespace",
              "infisical_project",
              "infisical_path"
            ],
            "properties": {
              "provider": {
                "const": "cloudflare"
              },
              "domain": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
              },
              "external_dns_owner_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "cloudflare_api_token_secret_name": {
                "const": "cloudflare-api-token"
              },
              "cloudflare_api_token_secret_namespace": {
                "const": "external-dns-system"
              },
              "infisical_project": {
                "const": "platform-dns"
              },
              "infisical_path": {
                "pattern": "^/dns/[a-z0-9][a-z0-9-]*/$"
              }
            }
          }
        },
        "required": []
      }
    }
  ],
  "$defs": {
    "channelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "enabledPlatforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "docker",
          "kubernetes"
        ]
      },
      "uniqueItems": true
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "k3s_version",
        "target"
      ],
      "properties": {
        "distribution": {
          "const": "k3s"
        },
        "k3s_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$"
        },
        "target": {
          "type": "string",
          "enum": [
            "k3d-local",
            "vultr-vms"
          ]
        },
        "k3d": {
          "$ref": "#/$defs/k3d"
        },
        "vultr_vms": {
          "$ref": "#/$defs/vultrVms"
        }
      },
      "oneOf": [
        {
          "properties": {
            "target": {
              "const": "k3d-local"
            }
          },
          "required": [
            "k3d"
          ],
          "not": {
            "required": [
              "vultr_vms"
            ]
          }
        },
        {
          "properties": {
            "target": {
              "const": "vultr-vms"
            }
          },
          "required": [
            "vultr_vms"
          ],
          "not": {
            "required": [
              "k3d"
            ]
          }
        }
      ]
    },
    "k3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servers",
        "agents",
        "registry_name"
      ],
      "properties": {
        "servers": {
          "type": "integer",
          "minimum": 1
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "registry_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vultrVms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "servers",
        "agents"
      ],
      "properties": {
        "region": {
          "$ref": "#/$defs/region"
        },
        "allowed_ssh_cidrs": {
          "$ref": "#/$defs/cidrList"
        },
        "remote_kubeconfig_path": {
          "type": "string",
          "minLength": 1,
          "default": "/root/humility-k3s.yaml"
        },
        "firewall_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null
        },
        "ssh_key_ids": {
          "$ref": "#/$defs/stringList"
        },
        "servers": {
          "$ref": "#/$defs/serverVmPool"
        },
        "agents": {
          "$ref": "#/$defs/agentVmPool"
        }
      }
    },
    "serverVmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "plan"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentVmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "plan"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "key",
        "region"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "key": {
          "type": "string",
          "pattern": "^channels/[a-z0-9-]+/terraform\\.tfstate$"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "default": "https://ewr1.vultrobjects.com"
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "git_url",
        "git_ref",
        "path",
        "kustomization_name",
        "kustomization_namespace",
        "sops_age_secret_name",
        "decryption_secret_namespace",
        "interval",
        "retry_interval",
        "prune",
        "wait"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "git"
          ]
        },
        "git_url": {
          "type": "string",
          "pattern": "^(http|https|ssh)://[^\\s]+$"
        },
        "git_ref": {
          "type": "string",
          "pattern": "^(refs/(heads|tags)/[A-Za-z0-9._/-]+|[A-Za-z0-9._/-]+)$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\./gitops/channels/[a-z0-9-]+$"
        },
        "kustomization_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kustomization_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "sops_age_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "decryption_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "retry_interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "prune": {
          "type": "boolean"
        },
        "wait": {
          "type": "boolean"
        }
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_url",
        "project_id",
        "environment",
        "secrets_path",
        "auth_method",
        "universal_auth_secret_name",
        "universal_auth_secret_namespace",
        "operator_namespace",
        "resync_interval"
      ],
      "properties": {
        "server_url": {
          "type": "string",
          "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "secrets_path": {
          "type": "string",
          "pattern": "^/([A-Za-z0-9._-]+(/|$))*$"
        },
        "auth_method": {
          "type": "string",
          "enum": [
            "universal-auth"
          ]
        },
        "universal_auth_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "universal_auth_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "operator_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "resync_interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        }
      }
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "minio",
            "vultr-object-storage"
          ]
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "credentials_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "credentials_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "infisical_project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        "infisical_path": {
          "type": "string",
          "pattern": "^/object-storage/[a-z0-9][a-z0-9-]*/$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "step-ca",
            "acme"
          ]
        },
        "local_cluster_issuer_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "step_ca_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "step_ca_service_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "step_issuer_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "sample_certificate_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "sample_certificate_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "local_domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "remote_cluster_issuer_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "acme_server": {
          "type": "string",
          "format": "uri"
        },
        "acme_email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "cloudflare_api_token_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "cloudflare_api_token_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "coredns",
            "cloudflare"
          ]
        },
        "local_domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "cluster_domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "coredns_configmap_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "coredns_configmap_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "sample_lookup_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "external_dns_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "cloudflare_api_token_secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "cloudflare_api_token_secret_namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "infisical_project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        "infisical_path": {
          "type": "string",
          "pattern": "^/dns/[a-z0-9][a-z0-9-]*/$"
        }
      }
    }
  }
}
