{
  "host_loopback": "127.0.0.1",
  "host_https_port": 443,
  "routes": {
    "public": {
      "host": "web.local.humility.local",
      "path": "/",
      "heading": "Humility applications",
      "status": 200
    },
    "application_form": {
      "path": "/applications",
      "link_name": "Application form"
    },
    "admin": {
      "host": "web.local.humility.local",
      "path": "/admin/chapters",
      "requires_auth": true,
      "allowed_unauthenticated_statuses": [302, 303, 401]
    }
  },
  "auth": {
    "identity": {
      "email": "officer@humility.local",
      "subject": "humility-officer-1",
      "groups": ["officers"]
    },
    "headers": {
      "x-pomerium-claim-email": "officer@humility.local",
      "x-pomerium-claim-sub": "humility-officer-1",
      "x-pomerium-claim-groups": "officers"
    },
    "probe_endpoint": "/api/me",
    "unauthenticated_api_status": 401,
    "applicant": {
      "me_endpoint": "/auth/discord/me",
      "start_endpoint": "/auth/discord/start?return_to=/applications",
      "receipt_cookie": "applicant_receipt",
      "login_button_name": "Login with Discord",
      "identity_indicator_prefix": "Logged in as Discord ",
      "receipt_required_error_code": "applicant_receipt_required"
    }
  },
  "form": {
    "route": "/applications",
    "fields": [
      {
        "type": "text",
        "name": "character_name",
        "label": "Character name",
        "value": "Test Applicant"
      },
      {
        "type": "textarea",
        "name": "application_text",
        "label": "Application text",
        "value": "I want to join scheduled guild activities."
      }
    ],
    "submit": {
      "button_name": "Submit application",
      "endpoint": "/api/public/applications",
      "method": "POST",
      "success_status": 201,
      "success_message": "Application received",
      "success_application_id": "11111111-1111-4111-8111-111111111111",
      "client_application_id_pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "payload_fields": [
        {
          "name": "scope.scope_kind",
          "value": "global"
        },
        {
          "name": "scope.scope_id",
          "value": null
        },
        {
          "name": "responses.character_name",
          "source_field": "character_name"
        },
        {
          "name": "responses.application_text",
          "source_field": "application_text"
        }
      ]
    }
  },
  "ui_libraries": {
    "ark": {
      "tab_name": "Details",
      "dialog_button_name": "Open details",
      "dialog_text": "Application details"
    },
    "fontawesome": {
      "submit_icon_test_id": "application-submit-icon",
      "status_icon_test_id": "application-status-icon"
    },
    "tanstack": {
      "navigation_link_name": "Application form",
      "resolved_path": "/applications"
    }
  }
}
