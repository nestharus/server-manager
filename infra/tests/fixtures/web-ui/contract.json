{
  "host_loopback": "127.0.0.1",
  "host_https_port": 443,
  "routes": {
    "public": {
      "host": "web.local.humility.local",
      "path": "/",
      "heading": "Humility applications",
      "status": 200
    },
    "application_form": {
      "path": "/applications",
      "link_name": "Application form"
    },
    "officer_queue": {
      "path": "/applications/queue",
      "link_name": "Officer queue",
      "requires_auth": true
    },
    "officer_detail": {
      "path": "/applications/{id}",
      "requires_auth": true
    },
    "admin": {
      "host": "web.local.humility.local",
      "path": "/admin/chapters",
      "requires_auth": true,
      "allowed_unauthenticated_statuses": [302, 303, 401]
    }
  },
  "auth": {
    "identity": {
      "email": "officer@humility.local",
      "subject": "humility-officer-1",
      "groups": ["officers"],
      "discord_user_id": "210987654321098765"
    },
    "headers": {
      "x-pomerium-claim-email": "officer@humility.local",
      "x-pomerium-claim-sub": "humility-officer-1",
      "x-pomerium-claim-groups": "officers",
      "x-pomerium-claim-discord-user-id": "210987654321098765"
    },
    "probe_endpoint": "/api/me",
    "unauthenticated_api_status": 401,
    "applicant": {
      "me_endpoint": "/auth/discord/me",
      "start_endpoint": "/auth/discord/start?return_to=/applications",
      "receipt_cookie": "applicant_receipt",
      "login_button_name": "Login with Discord",
      "identity_indicator_prefix": "Logged in as Discord ",
      "receipt_required_error_code": "applicant_receipt_required"
    }
  },
  "applications": {
    "queue": {
      "endpoint": "/api/web/officer/applications",
      "state_filter": "submitted,queued",
      "default_states_visible": ["submitted", "queued"]
    },
    "claim": {
      "endpoint": "/api/web/officer/applications/{id}/claim",
      "method": "POST",
      "if_match_header": true,
      "success_status": 200
    },
    "detail": {
      "endpoint": "/api/web/officer/applications/{id}",
      "method": "GET"
    },
    "transcript": {
      "endpoint": "/api/web/officer/applications/{id}/transcript",
      "method": "GET"
    },
    "message": {
      "endpoint": "/api/web/officer/applications/{id}/messages",
      "method": "POST",
      "success_statuses": [201, 200],
      "visibility_values": ["applicant_visible", "officer_only"]
    },
    "transition": {
      "endpoint": "/api/web/officer/applications/{id}/transitions",
      "method": "POST",
      "if_match_header": true,
      "success_status": 200,
      "actions": [
        "route",
        "review",
        "request_interview",
        "waitlist",
        "approve",
        "deny",
        "reactivate",
        "withdraw"
      ],
      "rejected_actions": ["claim"]
    }
  },
  "form": {
    "route": "/applications",
    "definition_endpoint": "/api/public/application-forms/current",
    "chapters": {
      "endpoint": "/api/public/chapters",
      "selected_id": "chapter-alpha",
      "selected_name": "Alpha Chapter",
      "response": {
        "chapters": [
          {
            "id": "chapter-alpha",
            "name": "Alpha Chapter"
          }
        ]
      }
    },
    "fields": [
      {
        "type": "chapter_select",
        "name": "chapter",
        "label": "Chapter",
        "value": "chapter-alpha"
      },
      {
        "type": "short",
        "name": "character_name",
        "label": "Character name",
        "value": "Test Applicant"
      },
      {
        "type": "long",
        "name": "application_text",
        "label": "Application text",
        "value": "I want to join scheduled guild activities."
      }
    ],
    "submit": {
      "button_name": "Submit application",
      "endpoint": "/api/public/applications",
      "method": "POST",
      "success_status": 201,
      "success_message": "Application received",
      "success_application_id": "11111111-1111-4111-8111-111111111111",
      "client_application_id_pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "payload_fields": [
        {
          "name": "scope.scope_kind",
          "value": "chapter"
        },
        {
          "name": "scope.scope_id",
          "value": "chapter-alpha"
        },
        {
          "name": "responses.chapter",
          "source_field": "chapter"
        },
        {
          "name": "responses.character_name",
          "source_field": "character_name"
        },
        {
          "name": "responses.application_text",
          "source_field": "application_text"
        }
      ]
    }
  },
  "ui_libraries": {
    "ark": {
      "tab_name": "Details",
      "dialog_button_name": "Open details",
      "dialog_text": "Application details"
    },
    "fontawesome": {
      "submit_icon_test_id": "application-submit-icon",
      "status_icon_test_id": "application-status-icon"
    },
    "tanstack": {
      "navigation_link_name": "Application form",
      "resolved_path": "/applications"
    }
  }
}
